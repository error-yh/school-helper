<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_course_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:background="@drawable/today_widget_row_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/widget_course_color"
        android:layout_width="3dp"
        android:layout_height="23dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/widget_course_content"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_course_name"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_course_meta"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_course_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:padding="2dp"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_course_time"
        android:layout_width="45dp"
        android:layout_height="32dp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeTextType="uniform"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:textColor="@color/widget_text" />
</LinearLayout>
